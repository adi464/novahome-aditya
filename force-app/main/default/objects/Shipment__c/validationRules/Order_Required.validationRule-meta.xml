<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Order_Required</fullName>
    <active>true</active>
    <description>Lookup kept optional at field level so it can carry field-level security; required here instead.</description>
    <errorConditionFormula>ISBLANK(Order__c)</errorConditionFormula>
    <errorDisplayField>Order__c</errorDisplayField>
    <errorMessage>Every shipment needs an order.</errorMessage>
</ValidationRule>
