<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Points_Not_Negative</fullName>
    <active>true</active>
    <description>Stops negative points.</description>
    <errorConditionFormula>Points_Balance__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Points_Balance__c</errorDisplayField>
    <errorMessage>Points balance cannot be negative.</errorMessage>
</ValidationRule>
